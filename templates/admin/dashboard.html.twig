{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — ImmoSearch{% endblock %}

{% block body %}
    <h1>Tableau de bord</h1>

    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-value">{{ totalBiens }}</span>
            <span class="stat-label">Biens au catalogue</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">{{ totalVisites }}</span>
            <span class="stat-label">Visites</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">{{ totalUtilisateurs }}</span>
            <span class="stat-label">Utilisateurs</span>
        </div>
    </div>

    <section>
        <h2>Biens par statut</h2>
        <ul class="kv-list">
            {% for statut, total in biensParStatut %}
                <li><span>{{ statut|replace({'_': ' '})|capitalize }}</span><strong>{{ total }}</strong></li>
            {% endfor %}
        </ul>
    </section>

    <section>
        <h2>Visites en attente</h2>
        <table class="table">
            <thead>
            <tr>
                <th>Date</th><th>Bien</th><th>Demandeur</th><th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for v in visitesEnAttente %}
                <tr>
                    <td>{{ v.dateVisite|date('d/m/Y H:i') }}</td>
                    <td><a href="{{ path('app_bien_show', {'id': v.bien.id}) }}">{{ v.bien.titre }}</a></td>
                    <td>{{ v.utilisateur.fullName }}</td>
                    <td>
                        <form method="post" action="{{ path('app_agent_visite_statut', {'id': v.id}) }}" class="inline-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('visite' ~ v.id) }}">
                            <button name="statut" value="confirmee" class="btn-small">Confirmer</button>
                            <button name="statut" value="refusee" class="btn-small btn-danger">Refuser</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucune demande en attente.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
