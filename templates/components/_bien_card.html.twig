<article class="bien-card">
    <a href="{{ path('app_bien_show', {'id': bien.id}) }}" class="bien-link">
        <div class="bien-photo">
            {% set photo = bien.photoPrincipale %}
            {% if photo %}
                <img src="{{ asset('uploads/' ~ photo.url) }}" alt="{{ bien.titre }}">
            {% else %}
                <div class="bien-photo-placeholder">Image de propriété</div>
            {% endif %}
            {% if bien.statut == 'sous_offre' %}
                <span class="bien-badge">Sous offre</span>
            {% elseif bien.statut == 'vendu' %}
                <span class="bien-badge">Vendu</span>
            {% elseif bien.statut == 'loue' %}
                <span class="bien-badge">Loué</span>
            {% elseif bien.dateCreation and (("now"|date("U") - bien.dateCreation|date("U")) < 30*86400) %}
                <span class="bien-badge">Nouveau</span>
            {% endif %}
            <button type="button" class="bien-fav" aria-label="Ajouter aux favoris" onclick="event.preventDefault(); this.querySelector('svg').style.fill = this.querySelector('svg').style.fill ? '' : 'currentColor';">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
        </div>
        <div class="bien-body">
            <p class="bien-price">{{ bien.prix|number_format(0, ',', ' ') }} €</p>
            <p class="bien-meta">
                {{ bien.caracteristique.nbrPiece ?? '—' }} pièce{{ (bien.caracteristique.nbrPiece ?? 0) > 1 ? 's' : '' }}
                <span class="sep">·</span>
                {{ bien.caracteristique.nbrChambre ?? '—' }} chambre{{ (bien.caracteristique.nbrChambre ?? 0) > 1 ? 's' : '' }}
                <span class="sep">·</span>
                {{ bien.surface }} m²
            </p>
            <p class="bien-address">{{ bien.adresse.rue ?? '' }}{% if bien.adresse.rue %}, {% endif %}{{ bien.adresse.codePostal ?? '' }} {{ bien.adresse.ville }}</p>
            <p class="bien-type">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/></svg>
                {{ bien.caracteristique.type|capitalize }}
            </p>
        </div>
    </a>
</article>
