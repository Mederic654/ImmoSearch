{% extends 'base.html.twig' %}

{% block title %}ImmoSearch — Trouvez votre prochain bien{% endblock %}

{% block body %}
    {# ============ Barre de recherche ============ #}
    <section class="search-band">
        <div class="container">
            {{ form_start(searchForm, {'attr': {'class': 'search-form'}}) }}
                <div class="search-bar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    {{ form_widget(searchForm.ville, {'attr': {'placeholder': 'Ville, quartier, code postal, adresse...', 'aria-label': 'Recherche'}}) }}
                    <button type="submit" aria-label="Rechercher">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </button>
                </div>

                <div class="search-filters">
                    {{ form_widget(searchForm.type) }}
                    {{ form_widget(searchForm.prixMax, {'attr': {'placeholder': 'Prix max'}}) }}
                    {{ form_widget(searchForm.surfaceMin, {'attr': {'placeholder': 'Surface min'}}) }}
                    {{ form_widget(searchForm.prixMin, {'attr': {'placeholder': 'Prix min'}}) }}
                    {{ form_widget(searchForm.tri) }}
                    <button type="submit" class="btn-save" aria-label="Sauvegarder la recherche">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        Sauvegarder
                    </button>
                </div>
            {{ form_end(searchForm) }}
        </div>
    </section>

    <div class="container page">
        {# ============ Carte (placeholder, MVP) ============ #}
        <div class="map-zone" aria-label="Carte des biens">
            <div class="map-counter">{{ biens|length }} biens sur <strong>{{ biens|length }}</strong></div>
            <div class="map-chips">
                <span class="map-chip">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V10l9-7 9 7v11h-7v-7h-4v7z"/></svg>
                    Écoles
                </span>
                <span class="map-chip">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="13" rx="2"/><circle cx="8" cy="20" r="1.5"/><circle cx="16" cy="20" r="1.5"/></svg>
                    Transports
                </span>
                <span class="map-chip">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l5-5 4 4 8-8"/></svg>
                    Dessiner
                </span>
            </div>
            {% set pin_positions = [
                {top: '20%', left: '15%'},
                {top: '32%', left: '40%'},
                {top: '45%', left: '70%'},
                {top: '60%', left: '25%'},
                {top: '55%', left: '55%'},
                {top: '70%', left: '45%'},
                {top: '38%', left: '85%'},
                {top: '25%', left: '60%'}
            ] %}
            {% for bien in biens|slice(0, 8) %}
                {% set pos = pin_positions[loop.index0] %}
                <div class="map-pin" style="top: {{ pos.top }}; left: {{ pos.left }};">
                    {{ (bien.prix / 1000)|round }}K €
                </div>
            {% endfor %}
            {% if biens|length == 0 %}<span>Aucun bien à afficher sur la carte</span>{% endif %}
        </div>

        {# ============ Liste résultats ============ #}
        <section class="results">
            <div class="results-header">
                <h2>{{ biens|length }} bien{{ biens|length > 1 ? 's' : '' }} immobilier{{ biens|length > 1 ? 's' : '' }}</h2>
                <div class="results-actions">
                    <button class="btn-ghost" type="button">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
                        Trier par
                    </button>
                    <button class="btn-ghost" type="button" aria-label="Vue liste">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    </button>
                    <button class="btn-ghost" type="button" aria-label="Vue grille">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    </button>
                </div>
            </div>

            <div class="bien-grid">
                {% for bien in biens %}
                    {% include 'components/_bien_card.html.twig' with {'bien': bien} %}
                {% else %}
                    <p>Aucun bien ne correspond à votre recherche.</p>
                {% endfor %}
            </div>

            {% if biens|length > 0 %}
                <nav class="pagination" aria-label="Pagination">
                    <a href="#" aria-label="Précédent">‹</a>
                    <span class="current">1</span>
                    <a href="#">2</a>
                    <a href="#">3</a>
                    <a href="#" aria-label="Suivant">›</a>
                </nav>
            {% endif %}
        </section>
    </div>

    {# ============ Services ============ #}
    <section class="services-band">
        <div class="container">
            <h2>Nos services</h2>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
                    <h3>Recherche avancée</h3>
                    <p>Trouvez le bien parfait grâce à nos filtres détaillés et notre carte interactive.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg></div>
                    <h3>Agents experts</h3>
                    <p>Bénéficiez de l'accompagnement de professionnels de l'immobilier.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
                    <h3>Alertes personnalisées</h3>
                    <p>Recevez les nouvelles annonces correspondant à vos critères par email.</p>
                </div>
            </div>
        </div>
    </section>

    {# ============ CTA vendre ============ #}
    <section class="cta-band">
        <h2>Vous vendez votre bien ?</h2>
        <p>Profitez de notre audience de milliers d'acheteurs potentiels et vendez rapidement au meilleur prix.</p>
        <a href="#" class="btn-outline-white">Contacter un agent</a>
    </section>
{% endblock %}
