<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ImmoSearch{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="site-header">
    <div class="container header-inner">
        <nav class="header-nav-left" aria-label="Catégories">
            <a href="{{ path('app_home') }}?type=appartement">Acheter</a>
            <a href="{{ path('app_home') }}?type=appartement">Louer</a>
            <a href="#">Vendre</a>
            <a href="#">Agences</a>
        </nav>

        <a href="{{ path('app_home') }}" class="brand" aria-label="ImmoSearch — accueil">
            <span class="brand-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/></svg>
            </span>
            ImmoSearch
        </a>

        <nav class="header-nav-right" aria-label="Utilisateur">
            {% if is_granted('ROLE_AGENT') %}
                <a href="{{ path('app_agent_dashboard') }}">Tableau de bord</a>
                <a href="{{ path('app_agent_bien_index') }}">Biens</a>
            {% else %}
                <a href="#">Professionnels</a>
                <a href="#">Aide</a>
            {% endif %}

            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_profile_visites') }}" title="Mes visites">Mes visites</a>
                <a href="{{ path('app_logout') }}" title="Déconnexion" class="user-chip" aria-label="Compte">
                    {{ app.user.fullName|slice(0, 1)|upper }}
                </a>
            {% else %}
                <a href="{{ path('app_login') }}">Connexion</a>
                <a href="{{ path('app_register') }}" class="user-chip" aria-label="Inscription">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
                </a>
            {% endif %}

            <button class="menu-toggle" type="button" aria-label="Menu" onclick="document.getElementById('mobile-drawer').classList.add('open')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
        </nav>
    </div>
</header>

<div id="mobile-drawer" class="mobile-drawer" onclick="if(event.target===this)this.classList.remove('open')">
    <div class="mobile-drawer-panel">
        <button class="mobile-drawer-close" type="button" onclick="document.getElementById('mobile-drawer').classList.remove('open')" aria-label="Fermer">×</button>
        <a href="{{ path('app_home') }}">Acheter</a>
        <a href="{{ path('app_home') }}">Louer</a>
        <a href="#">Vendre</a>
        <a href="#">Agences</a>
        <a href="#">Professionnels</a>
        <a href="#">Aide</a>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_profile_visites') }}">Mes visites</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
    </div>
</div>

<main>
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="flash flash-{{ type }}">{{ msg }}</div>
            {% endfor %}
        {% endfor %}
    </div>

    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-col">
                <h4>À propos</h4>
                <ul>
                    <li><a href="#">Qui sommes-nous</a></li>
                    <li><a href="#">Notre équipe</a></li>
                    <li><a href="#">Nos agences</a></li>
                    <li><a href="#">Carrières</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Services</h4>
                <ul>
                    <li><a href="{{ path('app_home') }}">Acheter</a></li>
                    <li><a href="#">Vendre</a></li>
                    <li><a href="#">Louer</a></li>
                    <li><a href="#">Estimation gratuite</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Ressources</h4>
                <ul>
                    <li><a href="#">Guide de l'acheteur</a></li>
                    <li><a href="#">Guide du vendeur</a></li>
                    <li><a href="#">Blog immobilier</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="footer-col footer-contact">
                <h4>Contact</h4>
                <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> 01 23 45 67 89</div>
                <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> contact@immosearch.fr</div>
                <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Paris, France</div>
                <div class="footer-social" style="margin-top:.75rem">
                    <a href="#" aria-label="Facebook">f</a>
                    <a href="#" aria-label="Instagram">ig</a>
                    <a href="#" aria-label="LinkedIn">in</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© {{ "now"|date("Y") }} ImmoSearch. Tous droits réservés.</span>
            <div class="footer-legal">
                <a href="#">Mentions légales</a>
                <a href="#">Confidentialité</a>
                <a href="#">Cookies</a>
            </div>
        </div>
    </div>
</footer>
{% block javascripts %}{% endblock %}
</body>
</html>
